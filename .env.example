# Auth
ADMIN_USER=admin
ADMIN_PASSWORD=changeme
SESSION_SECRET=change-this-to-a-random-string

# Amazon S3 (global credentials, used unless a job overrides them)
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=us-east-1

# SMTP / Email Notifications
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
NOTIFY_FROM=backup-app@example.com
NOTIFY_TO=admin@example.com
SMTP_TLS=true

# Logging
LOG_RETENTION_DAYS=30
